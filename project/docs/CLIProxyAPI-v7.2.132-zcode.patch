+func TestSynthesizeAuthFileUnprotectsStoredAntigravityCredentials(t *testing.T) {
+	tempDir := t.TempDir()
+	fileName := "antigravity-runtime.json"
+	accessToken := "test-access-token"
+	refreshToken := "test-refresh-token"
+
+	store := sdkauth.NewFileTokenStore()
+	store.SetBaseDir(tempDir)
+	auth := &coreauth.Auth{
+		ID:       fileName,
+		FileName: fileName,
+		Metadata: map[string]any{
+			"type":          "antigravity",
+			"access_token":  accessToken,
+			"refresh_token": refreshToken,
+			"project_id":    "test-project",
+		},
+	}
+	fullPath, errSave := store.Save(context.Background(), auth)
+	if errSave != nil {
+		t.Fatalf("Save() error = %v", errSave)
+	}
+	raw, errRead := os.ReadFile(fullPath)
+	if errRead != nil {
+		t.Fatalf("read stored auth: %v", errRead)
+	}
+	if runtime.GOOS == "windows" {
+		var stored map[string]any
+		if errUnmarshal := json.Unmarshal(raw, &stored); errUnmarshal != nil {
+			t.Fatalf("unmarshal stored auth: %v", errUnmarshal)
+		}
+		storedAccess, _ := stored["access_token"].(string)
+		if storedAccess == accessToken || !strings.HasPrefix(storedAccess, "dpapi:v1:") {
+			t.Fatalf("stored access token is not DPAPI protected")
+		}
+	}
+
+	ctx := &SynthesisContext{
+		Config:      &config.Config{},
+		AuthDir:     tempDir,
+		Now:         time.Now(),
+		IDGenerator: NewStableIDGenerator(),
+	}
+	auths, errSynthesize := SynthesizeAuthFile(ctx, fullPath, raw)
+	if errSynthesize != nil {
+		t.Fatalf("SynthesizeAuthFile() error = %v", errSynthesize)
+	}
+	if len(auths) != 1 {
+		t.Fatalf("SynthesizeAuthFile() len = %d, want 1", len(auths))
+	}
+	if got, _ := auths[0].Metadata["access_token"].(string); got != accessToken {
+		t.Errorf("runtime access token was not restored")
+	}
+	if got, _ := auths[0].Metadata["refresh_token"].(string); got != refreshToken {
+		t.Errorf("runtime refresh token was not restored")
+	}
+}
