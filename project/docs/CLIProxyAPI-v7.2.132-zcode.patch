+func TestFetchProjectIDRetriesCompletedOnboardingUntilProjectPropagates(t *testing.T) {
+	attempts := 0
+	auth := NewAntigravityAuth(nil, &http.Client{Transport: roundTripperFunc(func(req *http.Request) (*http.Response, error) {
