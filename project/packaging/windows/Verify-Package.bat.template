@echo off
setlocal EnableExtensions EnableDelayedExpansion
cd /d "%~dp0"
set "FAILED=0"
call :check "ZCode-Antigravity.exe" "__MANAGER_SHA256__"
call :check "ZCode-Antigravity-ControlCenter.exe" "__CONTROL_CENTER_SHA256__"
call :check "backend\cli-proxy-api.exe" "__BACKEND_SHA256__"
echo.
if "!FAILED!"=="0" (
  echo Verification passed.
) else (
  echo Verification FAILED. Do not run this package.
)
pause
exit /b !FAILED!

:check
set "FILE=%~1"
set "EXPECTED=%~2"
set "ACTUAL="
if not exist "%FILE%" (
  echo [MISSING] %FILE%
  set "FAILED=1"
  exit /b
)
for /f "skip=1 tokens=* delims=" %%H in ('certutil -hashfile "%FILE%" SHA256 2^>nul') do if not defined ACTUAL set "ACTUAL=%%H"
set "ACTUAL=!ACTUAL: =!"
if /I "!ACTUAL!"=="!EXPECTED!" (
  echo [OK] %FILE%
) else (
  echo [BAD] %FILE%
  echo       expected: !EXPECTED!
  echo       actual:   !ACTUAL!
  set "FAILED=1"
)
exit /b
