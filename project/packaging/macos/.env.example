# Public source builds need an OAuth desktop client configuration that you are
# authorized to use. Official release binaries may inject this configuration at
# link time and do not need this file.
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Optional proxy examples:
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
